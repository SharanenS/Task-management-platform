# Copy to .env and replace every change-me value with a unique local secret.
FRONTEND_PORT=3010
GATEWAY_PORT=8010
KEYCLOAK_PORT=8080
EMPLOYEE_DB_PORT=5435
SESSION_REDIS_PORT=6380
APP_ENV=development
LOG_LEVEL=INFO
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database
EMPLOYEE_DB_PASSWORD=change-me-employee-database
INTERNAL_SERVICE_KEY=change-me-internal-service-key
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Used only by scripts/bootstrap-development.ps1. These values are not consumed
# by application containers and do not enable public registration.
DEV_USER_USERNAME=local.user
DEV_USER_PASSWORD=change-me-development-user
DEV_USER_EMAIL=local.user@example.test
DEV_USER_DISPLAY_NAME=Local User
DEV_USER_ROLE=ADMIN
