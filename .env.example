# Copy to .env and replace every change-me value with a unique local secret.
FRONTEND_PORT=3010
GATEWAY_PORT=8010
KEYCLOAK_PORT=8080
EMPLOYEE_DB_PORT=5435
WORK_DB_PORT=5436
SESSION_REDIS_PORT=6380
APP_ENV=development
LOG_LEVEL=INFO
KEYCLOAK_DB_PASSWORD=change-me-keycloak-database
EMPLOYEE_DB_PASSWORD=change-me-employee-database
INTERNAL_SERVICE_KEY=change-me-internal-service-key
WORK_DB_PASSWORD=change-me-work-database
WORK_INTERNAL_SERVICE_KEY=change-me-work-internal-service-key
KEYCLOAK_ADMIN_CLIENT_SECRET=change-me-employee-admin-client
KEYCLOAK_ADMIN_USERNAME=local-admin
KEYCLOAK_ADMIN_PASSWORD=change-me-keycloak-admin

# Used only by scripts/bootstrap-development.ps1. These values are not consumed
# by application containers and do not enable public registration.
DEV_USER_USERNAME=local.user
DEV_USER_PASSWORD=change-me-development-user
DEV_USER_EMAIL=local.user@example.test
DEV_USER_DISPLAY_NAME=Local User
DEV_USER_ROLE=ADMIN

# Disposable Phase 3 browser verification identity. Keep real values only in .env.
PHASE3_E2E_USERNAME=phase3.employee
PHASE3_E2E_EMAIL=phase3.employee@example.test
PHASE3_E2E_DISPLAY_NAME=Phase Three Employee
PHASE3_E2E_TEMP_PASSWORD=change-me-phase3-temporary
PHASE3_E2E_PASSWORD=change-me-phase3-final

# Disposable Phase 4 multi-role browser verification passwords. Identities are
# generated per run; keep real values only in .env.
PHASE4_E2E_TEMP_PASSWORD=change-me-phase4-temporary
PHASE4_E2E_PASSWORD=change-me-phase4-final
