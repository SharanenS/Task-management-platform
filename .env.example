# Copy this file to .env and adjust values as needed.
# .env is gitignored — never commit real credentials.

# --- PostgreSQL (Docker) ---
# Host port is 5433 (not 5432) so this project's Postgres container never
# collides with another local Postgres installation.
DB_NAME=taskplatform
DB_USER=taskplatform_user
DB_PASSWORD=change_me_locally
DB_HOST=localhost
DB_PORT=5433

# --- Redis (Docker) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Spring Boot ---
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
