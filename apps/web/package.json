{
  "name": "taskspace-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.5.1",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3020",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3020",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format:check": "prettier --check .",
    "test": "node --conditions=react-server --experimental-strip-types --test tests/unit/*.test.ts",
    "test:e2e": "playwright test",
    "codegen": "graphql-codegen --config codegen.ts && prettier --write src/shared/api/generated.ts"
  },
  "dependencies": {
    "graphql": "17.0.2",
    "next": "16.4.6",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "redis": "6.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/typed-document-node": "7.1.1",
    "@graphql-codegen/typescript": "6.1.1",
    "@graphql-codegen/typescript-operations": "6.1.10",
    "@graphql-typed-document-node/core": "3.2.0",
    "@playwright/test": "1.64.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3"
  }
}
