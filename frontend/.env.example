# Server-side rewrite target. Never prefix this with NEXT_PUBLIC_.
# Next.js production builds capture this value at build time.
APP_BASE_URL=http://localhost:3010
GATEWAY_URL=http://127.0.0.1:8010
OIDC_ISSUER=http://localhost:8080/realms/taskspace
OIDC_INTERNAL_BASE_URL=http://localhost:8080
OIDC_CLIENT_ID=taskspace-web
OIDC_ALLOW_INSECURE_LOCAL=true
REDIS_URL=redis://127.0.0.1:6380
