{
  "name": "enterprise-task-platform-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3010",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "codegen": "graphql-codegen --config codegen.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@tanstack/react-query": "5.104.1",
    "graphql": "17.0.2",
    "@graphql-typed-document-node/core": "3.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "@radix-ui/react-dialog": "1.2.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0",
    "lucide-react": "1.53.0"
  },
  "devDependencies": {
    "typescript": "6.0.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "@graphql-codegen/cli": "7.4.5",
    "@graphql-codegen/client-preset": "6.2.2",
    "vitest": "5.0.3",
    "@vitejs/plugin-react": "6.1.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "jsdom": "30.1.2",
    "@playwright/test": "1.64.0",
    "prettier": "3.9.9"
  },
  "packageManager": "npm@11.21.0",
  "type": "module"
}
