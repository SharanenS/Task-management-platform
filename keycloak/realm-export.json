{
  "id": "enterprise",
  "realm": "enterprise",
  "displayName": "Enterprise Task Platform",
  "enabled": true,
  "registrationAllowed": false,
  "clients": [
    {
      "clientId": "task-platform",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dev-only-client-secret",
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "publicClient": false,
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-mapper",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "task-platform",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "System",
      "lastName": "Admin",
      "email": "admin@enterprise.local",
      "credentials": [
        {
          "type": "password",
          "value": "dev-only-admin-password",
          "temporary": false
        }
      ],
      "realmRoles": [
        "ADMIN"
      ]
    }
  ],
  "roles": {
    "realm": [
      {
        "name": "ADMIN",
        "description": "Full administrative access"
      },
      {
        "name": "MANAGER",
        "description": "Team and workflow management access"
      },
      {
        "name": "MEMBER",
        "description": "Standard team member access"
      }
    ]
  }
}
